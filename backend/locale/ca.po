msgid "operaciones"
msgstr "operacions"

#: app.py:20255
msgid "Se pueden recorrer las {n} de mayor importe de esta selección; para ver el resto, afina con los filtros."
msgstr "Es poden recórrer les {n} de més import d'aquesta selecció; per veure la resta, afina amb els filtres."

#: app.py:20258 app.py:20679 app.py:22627
msgid "Volver al inicio"
msgstr "Tornar a l'inici"

#: app.py:20260 app.py:20928
msgid "Fondos y proyectos financiados por la UE"
msgstr "Fons i projectes finançats per la UE"

