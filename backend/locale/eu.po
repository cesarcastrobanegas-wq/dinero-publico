#: app.py:27793
msgid "Varias alertas y aviso diario"
msgstr "Hainbat alerta eta eguneko abisua"

#: app.py:27793
msgid "Hasta 10 alertas, con un aviso cada día que haya novedades."
msgstr "Gehienez 10 alerta, berritasunak dauden egun bakoitzean abisu batekin."

#: app.py:27793
msgid "Próximamente."
msgstr "Laster."

#: app.py:27798
msgid "Te escribiremos cuando aparezca algo nuevo que cumpla estos filtros."
msgstr "Iragazki hauek betetzen dituen zerbait berria agertzen denean idatziko dizugu."

#: app.py:27801
msgid "No hemos encontrado ese municipio. Búscalo en la portada y usa el aviso de su ficha."
msgstr "Ez dugu udalerri hori aurkitu. Bilatu azalean eta erabili haren fitxako abisua."

#: app.py:27803
msgid "Contratos nuevos de tu ayuntamiento"
msgstr "Zure udalaren kontratu berriak"

#: app.py:27804
msgid "Escribe el nombre de tu municipio y te avisamos cuando adjudique contratos nuevos."
msgstr "Idatzi zure udalerriaren izena, eta kontratu berriak esleitzen dituenean abisatuko dizugu."

#: app.py:27806
msgid "Nombre de tu municipio"
msgstr "Zure udalerriaren izena"

#: app.py:27807
msgid "Continuar"
msgstr "Jarraitu"

#: app.py:27808
msgid "Licitaciones y subvenciones abiertas"
msgstr "Lizitazio eta diru-laguntza irekiak"

#: app.py:27809
msgid "Elige zona, sector, palabras clave o tipo de administración en la página de convocatorias y pulsa «Avísame por correo»."
msgstr "Aukeratu eremua, sektorea, gako-hitzak edo administrazio mota deialdien orrian, eta sakatu «Abisatu posta bidez»."

#: app.py:27814
msgid "Te avisamos por correo cuando haya contratos nuevos de tu ayuntamiento, o licitaciones y subvenciones abiertas que te interesen. Solo pedimos tu correo, y puedes darte de baja con un clic."
msgstr "Posta bidez abisatzen dizugu zure udalak kontratu berriak dituenean, edo interesatzen zaizkizun lizitazio eta diru-laguntza irekiak daudenean. Zure helbidea bakarrik eskatzen dugu, eta klik batekin eman dezakezu baja."

#: app.py:27818 app.py:27813 app.py:27280
msgid "Alertas por correo"
msgstr "Posta bidezko alertak"

#: app.py:27819
msgid "Avisos por correo de contratos nuevos de tu ayuntamiento y de licitaciones y subvenciones abiertas."
msgstr "Posta bidezko abisuak: zure udalaren kontratu berriak eta lizitazio eta diru-laguntza irekiak."

#: app.py:27830
msgid "Revisa tu correo"
msgstr "Begiratu zure posta"

#: app.py:27830
msgid "Si la dirección es correcta, te acabamos de enviar un mensaje con un enlace. Púlsalo para activar la alerta."
msgstr "Helbidea zuzena bada, esteka bat duen mezu bat bidali berri dizugu. Sakatu esteka alerta aktibatzeko."

#: app.py:27830
msgid "Si no lo ves en unos minutos, mira en la carpeta de correo no deseado. Sin confirmar no se envía nada más y la solicitud se borra sola en 7 días."
msgstr "Minutu batzuen buruan ikusten ez baduzu, begiratu spam karpetan. Berretsi gabe ez da besterik bidaltzen, eta eskaera 7 egunen buruan berez ezabatzen da."

#: app.py:27834
msgid "Confirmar la alerta"
msgstr "Alerta berretsi"

#: app.py:27839
msgid "Este enlace ya no es válido: puede que ya te hayas dado de baja."
msgstr "Esteka honek ez du jada balio: baliteke baja emana izatea dagoeneko."

#: app.py:27842
msgid "Darte de baja"
msgstr "Baja eman"

#: app.py:27845
msgid "Activa"
msgstr "Aktibo"

#: app.py:27845
msgid "Pendiente de confirmar"
msgstr "Berresteko zain"

#: app.py:27847
msgid "Borrar esta alerta"
msgstr "Alerta hau ezabatu"

#: app.py:27848
msgid "No tienes ninguna alerta."
msgstr "Ez daukazu alertarik."

#: app.py:27849
msgid "Plan gratuito: 1 alerta, resumen semanal."
msgstr "Doako plana: alerta 1, asteko laburpena."

#: app.py:27850
msgid "Plan de varias alertas: hasta 10, con aviso diario."
msgstr "Hainbat alertako plana: gehienez 10, eguneko abisuarekin."

#: app.py:27851
msgid "Tus alertas"
msgstr "Zure alertak"

#: app.py:27852
msgid "Crear otra alerta"
msgstr "Beste alerta bat sortu"

#: app.py:27854 app.py:27842
msgid "Darme de baja y borrar mi correo"
msgstr "Baja eman eta nire helbidea ezabatu"

#: app.py:27867
msgid "Correo no válido"
msgstr "Helbide baliogabea"

#: app.py:27867
msgid "Esa dirección de correo no parece válida. Vuelve atrás y revísala."
msgstr "Helbide elektroniko horrek ez du baliozkoa ematen. Itzuli atzera eta berrikusi."

#: app.py:27872
msgid "No se ha podido activar"
msgstr "Ezin izan da aktibatu"

#: app.py:27872
msgid "Este enlace ya no es válido: la solicitud ha caducado o ya tienes todas las alertas de tu plan."
msgstr "Esteka honek ez du jada balio: eskaera iraungi da, edo zure planeko alerta guztiak dauzkazu dagoeneko."

#: app.py:27878
msgid "Alerta activada"
msgstr "Alerta aktibatuta"

#: app.py:27878
msgid "Listo. Te escribiremos cuando haya novedades."
msgstr "Eginda. Berritasunak daudenean idatziko dizugu."

#: app.py:27878
msgid "En cada correo tendrás un enlace para darte de baja con un clic."
msgstr "Mezu bakoitzean esteka bat izango duzu klik batekin baja emateko."

#: app.py:27883
msgid "Te has dado de baja"
msgstr "Baja eman duzu"

#: app.py:27883
msgid "Hemos borrado tu correo y tus alertas. No recibirás más mensajes."
msgstr "Zure helbidea eta zure alertak ezabatu ditugu. Ez duzu mezu gehiago jasoko."

#: app.py:27888 app.py:27833 app.py:27839
msgid "Enlace no válido"
msgstr "Esteka baliogabea"

#: app.py:27888 app.py:27833
msgid "Este enlace no es válido o ha caducado."
msgstr "Esteka hau ez da baliozkoa edo iraungi da."

#: app.py:28131
msgid "No encontramos esta página. Puede que la dirección esté mal escrita o que la página haya cambiado de sitio."
msgstr "Ez dugu orri hau aurkitu. Baliteke helbidea gaizki idatzita egotea edo orria lekuz aldatu izana."

#: app.py:28134
msgid "Municipio, empresa o directivo…"
msgstr "Udalerria, enpresa edo zuzendaria…"

#: app.py:28137
msgid "O ve directamente a:"
msgstr "Edo joan zuzenean:"

#: app.py:28139
msgid "Portada"
msgstr "Hasiera"

