msgid "Además hay {n} operaciones de ámbito regional ({comunidad}) sin provincia concreta, por {importe}: no se suman a ninguna provincia."
msgstr "Ademais hai {n} operacións de ámbito rexional ({comunidad}) sen provincia concreta, por {importe}: non se suman a ningunha provincia."

